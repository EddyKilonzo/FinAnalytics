<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Verify your FinAnalytics email</title>
  <style>
    body { margin: 0; padding: 0; background-color: #051F20; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
    .wrapper { background-color: #051F20; padding: 40px 16px; }
    .container { max-width: 600px; margin: 0 auto; background-color: #0A2E2F; border-radius: 12px; border: 1px solid rgba(34,197,94,0.15); overflow: hidden; }
    .header { padding: 32px 40px 24px; border-bottom: 1px solid rgba(34,197,94,0.15); }
    .logo { font-size: 22px; font-weight: 800; color: #22c55e; letter-spacing: -0.03em; }
    .body { padding: 36px 40px; }
    .greeting { font-size: 24px; font-weight: 700; color: #DAF1DE; margin: 0 0 16px; }
    .text { font-size: 15px; color: rgba(218,241,222,0.65); line-height: 1.7; margin: 0 0 16px; }
    .code-block { background-color: rgba(34,197,94,0.08); border: 1px solid rgba(34,197,94,0.25); border-radius: 8px; padding: 20px 24px; margin: 24px 0; text-align: center; }
    .code-label { font-size: 12px; color: rgba(218,241,222,0.5); text-transform: uppercase; letter-spacing: 0.08em; margin: 0 0 8px; }
    .code-value { font-size: 36px; font-weight: 800; color: #22c55e; letter-spacing: 0.15em; margin: 0; }
    .cta-btn { display: inline-block; margin: 8px 0 0; padding: 13px 32px; background-color: #22c55e; color: #051F20; font-size: 15px; font-weight: 700; text-decoration: none; border-radius: 8px; }
    .divider { text-align: center; margin: 20px 0; color: rgba(218,241,222,0.3); font-size: 13px; }
    .link-text { font-size: 13px; color: rgba(218,241,222,0.5); word-break: break-all; }
    .link-text a { color: #22c55e; }
    .expiry-note { font-size: 13px; color: rgba(218,241,222,0.4); margin: 20px 0 0; }
    .footer { padding: 20px 40px; border-top: 1px solid rgba(34,197,94,0.15); text-align: center; }
    .footer-text { font-size: 12px; color: rgba(218,241,222,0.4); margin: 0; }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="container">
      <div class="header">
        <div class="logo">FinAnalytics</div>
      </div>
      <div class="body">
        <h1 class="greeting">Verify your email, <%= name %></h1>
        <p class="text">To complete your FinAnalytics registration, verify your email address using the code below or by clicking the button.</p>

        <div class="code-block">
          <p class="code-label">Your verification code</p>
          <p class="code-value"><%= verificationCode %></p>
        </div>

        <div style="text-align:center;">
          <a href="<%= verificationLink %>" class="cta-btn" target="_blank" rel="noreferrer">Verify Email Address</a>
        </div>

        <div class="divider">or copy this link</div>
        <p class="link-text"><a href="<%= verificationLink %>" target="_blank" rel="noreferrer"><%= verificationLink %></a></p>

        <p class="expiry-note">This code and link expire in 24 hours. If you did not create a FinAnalytics account, you can safely ignore this email.</p>
      </div>
      <div class="footer">
        <p class="footer-text">© 2026 FinAnalytics · Nairobi, Kenya</p>
      </div>
    </div>
  </div>
</body>
</html>
