<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Account deleted</title>
  <style>
    body { margin: 0; padding: 0; background-color: #051F20; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
    .wrapper { background-color: #051F20; padding: 40px 16px; }
    .container { max-width: 600px; margin: 0 auto; background-color: #0A2E2F; border-radius: 12px; border: 1px solid rgba(34,197,94,0.15); overflow: hidden; }
    .header { padding: 32px 40px 24px; border-bottom: 1px solid rgba(34,197,94,0.15); }
    .logo { font-size: 22px; font-weight: 800; color: #22c55e; letter-spacing: -0.03em; }
    .body { padding: 36px 40px; }
    .greeting { font-size: 24px; font-weight: 700; color: #DAF1DE; margin: 0 0 16px; }
    .text { font-size: 15px; color: rgba(218,241,222,0.65); line-height: 1.7; margin: 0 0 16px; }
    .info-box { background-color: rgba(34,197,94,0.06); border: 1px solid rgba(34,197,94,0.15); border-radius: 8px; padding: 16px 20px; margin: 20px 0; }
    .info-text { font-size: 14px; color: rgba(218,241,222,0.6); margin: 0; line-height: 1.6; }
    .warning-box { background-color: rgba(239,68,68,0.08); border: 1px solid rgba(239,68,68,0.25); border-radius: 8px; padding: 14px 18px; margin: 20px 0 0; }
    .warning-text { font-size: 14px; color: rgba(218,241,222,0.75); margin: 0; }
    .footer { padding: 20px 40px; border-top: 1px solid rgba(34,197,94,0.15); text-align: center; }
    .footer-text { font-size: 12px; color: rgba(218,241,222,0.4); margin: 0; }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="container">
      <div class="header">
        <div class="logo">FinAnalytics</div>
      </div>
      <div class="body">
        <h1 class="greeting">Account deleted</h1>
        <p class="text">Hi <%= name %>, your FinAnalytics account has been permanently deleted.</p>

        <div class="info-box">
          <p class="info-text">All your data — transactions, budgets, goals, and settings — has been removed from our systems. This action cannot be undone.</p>
        </div>

        <p class="text">We're sorry to see you go. If you ever want to return, you're welcome to create a new account at any time.</p>

        <div class="warning-box">
          <p class="warning-text">If you did not request this deletion, contact support immediately — your account may have been compromised.</p>
        </div>
      </div>
      <div class="footer">
        <p class="footer-text">© 2026 FinAnalytics · Nairobi, Kenya</p>
      </div>
    </div>
  </div>
</body>
</html>
