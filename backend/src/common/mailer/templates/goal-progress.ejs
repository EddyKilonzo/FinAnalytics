<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Goal Progress Update</title>
  <style>
    body { margin: 0; padding: 0; background-color: #051F20; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
    .wrapper { background-color: #051F20; padding: 40px 16px; }
    .container { max-width: 600px; margin: 0 auto; background-color: #0A2E2F; border-radius: 12px; border: 1px solid rgba(34,197,94,0.15); overflow: hidden; }
    .header { padding: 32px 40px 24px; border-bottom: 1px solid rgba(34,197,94,0.15); }
    .logo { font-size: 22px; font-weight: 800; color: #22c55e; letter-spacing: -0.03em; }
    .body { padding: 36px 40px; }
    .greeting { font-size: 24px; font-weight: 700; color: #DAF1DE; margin: 0 0 16px; }
    .text { font-size: 15px; color: rgba(218,241,222,0.65); line-height: 1.7; margin: 0 0 16px; }
    .goal-card { background-color: rgba(34,197,94,0.06); border: 1px solid rgba(34,197,94,0.2); border-radius: 10px; padding: 24px; margin: 24px 0; }
    .goal-name { font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.07em; color: rgba(218,241,222,0.5); margin: 0 0 6px; }
    .goal-pct { font-size: 44px; font-weight: 800; color: #22c55e; margin: 0 0 2px; line-height: 1; }
    .goal-pct-label { font-size: 14px; color: rgba(218,241,222,0.5); margin: 0 0 16px; }
    .progress-bar-bg { background-color: rgba(34,197,94,0.1); border-radius: 99px; height: 10px; overflow: hidden; margin-bottom: 16px; }
    .progress-bar-fill { height: 10px; border-radius: 99px; background-color: #22c55e; }
    .stats-row { display: flex; gap: 0; border-radius: 8px; overflow: hidden; border: 1px solid rgba(34,197,94,0.1); }
    .stat-cell { flex: 1; padding: 12px 14px; background-color: rgba(34,197,94,0.04); border-right: 1px solid rgba(34,197,94,0.08); }
    .stat-cell:last-child { border-right: none; }
    .stat-label { font-size: 11px; color: rgba(218,241,222,0.4); text-transform: uppercase; letter-spacing: 0.07em; margin: 0 0 3px; }
    .stat-value { font-size: 15px; font-weight: 700; color: #DAF1DE; margin: 0; }
    .congrats-box { background-color: rgba(34,197,94,0.1); border: 1px solid rgba(34,197,94,0.3); border-radius: 8px; padding: 16px 20px; margin: 20px 0; text-align: center; }
    .congrats-text { font-size: 16px; font-weight: 700; color: #22c55e; margin: 0; }
    .footer { padding: 20px 40px; border-top: 1px solid rgba(34,197,94,0.15); text-align: center; }
    .footer-text { font-size: 12px; color: rgba(218,241,222,0.4); margin: 0; }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="container">
      <div class="header">
        <div class="logo">FinAnalytics</div>
      </div>
      <div class="body">
        <% var isComplete = percentageComplete >= 100; %>
        <% if (isComplete) { %>
          <h1 class="greeting">Goal achieved, <%= name %>!</h1>
          <p class="text">Congratulations — you've reached your savings goal for <strong style="color:#DAF1DE;"><%= goalName %></strong>.</p>
        <% } else { %>
          <h1 class="greeting">Great progress, <%= name %>!</h1>
          <p class="text">Here's your latest update on your savings goal: <strong style="color:#DAF1DE;"><%= goalName %></strong>.</p>
        <% } %>

        <div class="goal-card">
          <p class="goal-name"><%= goalName %></p>
          <p class="goal-pct"><%= Math.round(percentageComplete) %>%</p>
          <p class="goal-pct-label"><%= isComplete ? 'Goal complete!' : 'of goal reached' %></p>

          <% var barPct = Math.min(percentageComplete, 100); %>
          <div class="progress-bar-bg">
            <div class="progress-bar-fill" style="width:<%= barPct %>%;"></div>
          </div>

          <div class="stats-row">
            <div class="stat-cell">
              <p class="stat-label">Saved</p>
              <p class="stat-value"><%= currency %> <%= currentAmount.toLocaleString() %></p>
            </div>
            <div class="stat-cell">
              <p class="stat-label">Target</p>
              <p class="stat-value"><%= currency %> <%= targetAmount.toLocaleString() %></p>
            </div>
            <div class="stat-cell">
              <p class="stat-label"><%= isComplete ? 'Achieved' : 'Remaining' %></p>
              <% var diff = Math.max(targetAmount - currentAmount, 0); %>
              <p class="stat-value" style="color:<%= isComplete ? '#22c55e' : '#DAF1DE' %>"><%= isComplete ? '✓' : currency + ' ' + diff.toLocaleString() %></p>
            </div>
          </div>
        </div>

        <% if (isComplete) { %>
          <div class="congrats-box">
            <p class="congrats-text">You did it! Your discipline and consistency paid off.</p>
          </div>
          <p class="text">Consider what's next — set a new goal or invest your savings to grow further.</p>
        <% } else { %>
          <p class="text">Keep going! Every contribution brings you closer to your target. Consistent saving, even in small amounts, adds up faster than you think.</p>
        <% } %>
      </div>
      <div class="footer">
        <p class="footer-text">© 2026 FinAnalytics · Nairobi, Kenya</p>
      </div>
    </div>
  </div>
</body>
</html>
